{
  "name": "realbrowser",
  "version": "0.1.0",
  "description": "Interactive embedded browser plugin for DSH with Chrome DevTools and Element Picker",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build-client.js",
    "test": "vitest run",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
