{
  "name": "dsh-realbrowser",
  "version": "0.0.1",
  "description": "Full agentic web browser for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prv-ctech/dsh-realbrowser.git"
  },
  "homepage": "https://github.com/prv-ctech/dsh-realbrowser#readme",
  "bugs": {
    "url": "https://github.com/prv-ctech/dsh-realbrowser/issues"
  },
  "type": "module",
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build-client.js",
    "test": "vitest run",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
